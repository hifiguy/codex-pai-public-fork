# PAI Environment Variables
# ==========================
#
# SINGLE SOURCE OF TRUTH for all API keys and authentication.
# Copy this file to $PAI_DIR/.env and fill in your values.
#
# Location: $PAI_DIR/.env (e.g., ~/.config/pai/.env)
#
# SECURITY RULES:
# 1. NEVER commit .env files to git
# 2. NEVER store API keys anywhere else in PAI
# 3. ALL packs and tools read from this ONE file

# ============================================================
# REQUIRED: System Configuration
# ============================================================

# Your DA's name
DA=YourDAName

# Your timezone
TIME_ZONE=America/Los_Angeles

# ============================================================
# OPTIONAL: Inference Backend
# ============================================================
#
# PAI tools route model calls through PAI/TOOLS/Inference.ts.
# Leave unset to use the ChatGPT Codex CLI, or choose another backend.
#
# Supported:
#   codex               ChatGPT Codex CLI
#   openai              OpenAI API
#   openai-compatible   Any /v1/chat/completions server
#   claude-code         Claude Code CLI using local Claude auth/subscription
#   anthropic           Anthropic Messages API
#   ollama              Local Ollama server
#   lmstudio            Local LM Studio server
#
# PAI_INFERENCE_BACKEND=codex
# PAI_INFERENCE_MODEL_FAST=gpt-5.4-mini
# PAI_INFERENCE_MODEL_STANDARD=gpt-5.4
# PAI_INFERENCE_MODEL_SMART=gpt-5.4
#
# For API backends:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PAI_INFERENCE_API_KEY=
# PAI_INFERENCE_BASE_URL=http://localhost:11434
#
# ============================================================
# PACK-SPECIFIC KEYS
# ============================================================
#
# Each pack documents its required API keys in its installation
# section. Add them here as you install packs.
#
# Example format:
# SERVICE_API_KEY=your_key_here
#
