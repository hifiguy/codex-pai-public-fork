# PAI Pulse Configuration
# Copy this file to PULSE.toml and customize for your setup

[pulse]
port = 31337
host = "localhost"

[modules]
# Enable/disable modules by setting to true/false
hooks = true
observability = true

# Example custom module — create your own in modules/
# my_module = true

[voice]
enabled = false
# tts_backend = "gemini"
# gemini_voice = "Leda"
# gemini_daily_request_limit = 250
# gemini_state_path = "/path/to/runtime/gemini-tts-state.json"
# gemini_style_instructions = "Speak naturally and clearly."
# Set GOOGLE_API_KEY, GEMINI_API_KEY, or GOOGLE_GENAI_API_KEY in your environment.
#
# ElevenLabs remains supported as an optional fallback/backend:
# tts_backend = "elevenlabs"
# default_voice_id = "YOUR_ELEVENLABS_VOICE_ID"
# api_key_env = "ELEVENLABS_API_KEY"

[notifications]
enabled = true

[checks]
# Health check interval in seconds
interval = 300
# Add your custom checks in checks/
